#!/usr/bin/python3 -I
# google: what ask-haiku (Claude Code) may ask of Google, through the local bridge (google-bridge.py).
#
#   google mails ["Gmail search"]           the inbox by default
#   google mail <n> [offset]                reads a mail from the last list
#   google contact "name"
#   google agenda [days]
#   google drive "words"
#   google document <n> [offset]            reads a file from the last list
#   google taches                           open tasks
#   google notes ["word"]                   Keep notes; sensitive ones without their content
#
# These only propose; nothing happens until the user says "oui" on the next turn:
#   google repondre <n> "text"                              reply
#   google envoyer "address, name or moi" "subject" "text"  send
#   google brouillon "address, name or moi" "subject" "text" draft
#   google archiver <n>                                     archive
#   google corbeille <n>                                    trash
#   google rdv "title" "vendredi 14h" [minutes] ["place"]   create an event
#   google annuler-rdv <n>                                  delete an event
#
# The action words are French because the model is prompted in French and they are the bridge's API (see README).
# Confirming is deliberately not a command here: only the assistant's script confirms, with tools.py --confirm,
# so nothing the model reads (a mail, a document) can make it confirm its own proposal.
import json
import sys
import urllib.error
import urllib.request

ENDPOINT = "http://127.0.0.1:8766/action"
ARGUMENTS = {"mails": ["requete"], "mail": ["numero", "suite"], "contact": ["requete"], "agenda": ["jours"], "drive": ["requete"], "document": ["numero", "suite"],
             "taches": [], "notes": ["requete"], "repondre": ["numero", "texte"], "envoyer": ["a", "objet", "texte"], "brouillon": ["a", "objet", "texte"],
             "archiver": ["numero"], "corbeille": ["numero"], "rdv": ["titre", "quand", "duree", "lieu"], "annuler-rdv": ["numero"]}


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    values = sys.argv[2:]
    if action not in ARGUMENTS or len(values) > len(ARGUMENTS[action]):
        sys.exit("Usage : google " + " | ".join(ARGUMENTS))
    body = {"action": action, "args": dict(zip(ARGUMENTS[action], values))}
    request = urllib.request.Request(ENDPOINT, json.dumps(body).encode(), {"X-Assistant": "1", "Content-Type": "application/json"})
    try:
        # No proxy: the bridge is on the loopback, and a proxy from the environment must not see these requests.
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(request, timeout=90) as response:
            print(response.read().decode())
    except urllib.error.HTTPError as e:
        sys.exit(e.read().decode(errors="replace") or f"Le pont Google a répondu {e.code}.")
    except OSError as e:
        sys.exit(f"Le pont Google ne répond pas ({e}).")


if __name__ == "__main__":
    main()
