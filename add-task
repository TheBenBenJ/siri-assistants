#!/usr/bin/python3 -I
# add-task: adds a task to the user's list and says where it went.
#
#   add-task "Appeler le garage"
#   add-task "Appeler le garage" vendredi     # or: demain, 3 novembre, 3/11, 2026-11-06
#
# Used by ask-haiku (as a shell command) and ask-local (tool add_task). Named ajouter-tache until 4 November 2026.
#
# The task goes through the dashboard's local server (POST /taches), which copies it to Google Tasks: the dashboard
# owns the Tasks token and the two-way sync, and the assistants never hold it. The task stays until it is ticked,
# on the dashboard or in Google Tasks. Every addition is logged to ~/.cache/ask/actions.log.
import datetime
import json
import os
import pwd
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))  # -I leaves the script's folder out of sys.path
from spoken_dates import say_date, spoken_date  # noqa: E402

HOME = pwd.getpwuid(os.getuid()).pw_dir
ACTIONS_LOG = os.path.join(HOME, ".cache/ask/actions.log")
ENDPOINT = "http://127.0.0.1:8765/taches"  # the dashboard; adapt to your own service


def main():
    if not 2 <= len(sys.argv) <= 3 or not sys.argv[1].strip():
        sys.exit('Usage : add-task "la tâche" [vendredi | demain | 3 novembre | 2026-11-06]')
    title = sys.argv[1].strip()
    date, due_text = None, ""
    if len(sys.argv) == 3 and sys.argv[2].strip():
        try:
            date = spoken_date(sys.argv[2], datetime.date.today())
        except ValueError:
            sys.exit(f"add-task : je ne comprends pas la date « {sys.argv[2]} », tâche non ajoutée.")
        due_text = f", pour le {say_date(date)}"

    # The dashboard's API: French keys; "assistant" marks a task kept until it is ticked.
    body = {"action": "ajouter", "assistant": True, "libelle": title, "echeance": date.isoformat() if date else ""}
    request = urllib.request.Request(ENDPOINT, json.dumps(body).encode(), {"X-Dashboard": "1", "Content-Type": "application/json"})
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(request, timeout=20) as response:
            google = json.load(response)["google"]  # "ok", "sans_jeton" (Google Tasks not linked yet) or an error
    except urllib.error.HTTPError as e:
        sys.exit(f"add-task : le dashboard a refusé la tâche ({e.read().decode(errors='replace')[:200]}).")
    except (OSError, ValueError, KeyError) as e:
        sys.exit(f"add-task : le dashboard ne répond pas ({e}), tâche non ajoutée.")

    os.makedirs(os.path.dirname(ACTIONS_LOG), exist_ok=True)
    with open(ACTIONS_LOG, "a") as f:
        f.write(time.strftime("%F %T  ") + f"task \"{title}\"{' due ' + date.isoformat() if date else ''} (Google: {google})\n")
    if google == "ok":
        print(f"Fait : « {title} » est dans Google Tasks et sur le dashboard{due_text}.")
    elif google == "sans_jeton":
        print(f"Fait : « {title} » est sur le dashboard{due_text}. Google Tasks n'est pas encore relié.")
    else:
        print(f"Fait : « {title} » est sur le dashboard{due_text}. Google Tasks ne répond pas : elle y sera recopiée dès que possible.")


if __name__ == "__main__":
    main()
