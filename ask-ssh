#!/bin/zsh
# ask-ssh: the only command the shortcuts' SSH keys may run on this machine (the Mac or a server), forced by
# restrict,command="..." in ~/.ssh/authorized_keys. It only accepts:
#   ask-haiku --reset | ask-local --reset
#   ask-haiku --chat [question] | ask-local --chat [question]
# The question follows the command or arrives on stdin; it is handed to the script on stdin as data, never run.
# Every question is logged to ~/.cache/ask/ssh.log, without its text: a failing shortcut would otherwise leave no trace here.
set -euo pipefail
zmodload zsh/datetime
me=$(/usr/bin/id -un)
readonly HOME_DIR=~$me  # home folder according to the system, not $HOME (/Users/... on the Mac, elsewhere on Linux)
readonly SSH_LOG="$HOME_DIR/.cache/ask/ssh.log"

# The shortcut sends the text of its "Script" field: a full path and extra blanks are tolerated.
words=(${=SSH_ORIGINAL_COMMAND:-})
refuse() {
  print -u2 "ask-ssh : commande refusée (${SSH_ORIGINAL_COMMAND:-vide})."
  exit 1
}
(( ${#words} >= 2 )) || refuse

script="${words[1]:t}"
target="$HOME_DIR/.local/bin/$script"
case "$script ${words[2]}" in
  (ask-haiku\ --reset|ask-local\ --reset)
    (( ${#words} == 2 )) || refuse
    exec "$target" --reset
    ;;
  (ask-haiku\ --chat|ask-local\ --chat)
    question=""
    if (( ${#words} > 2 )); then
      question="${(j: :)words[3,-1]}"
    else
      # No question in the command: it comes on stdin, or Siri heard nothing. Shortcuts may leave stdin open without
      # writing to it: do not wait, or the shortcut would time out.
      IFS= read -r -t 2 question || true
    fi
    /bin/mkdir -p "${SSH_LOG:h}"
    said=(${=question})
    print -r -- "$(/bin/date '+%F %T')  $script --chat: start, ${#said} words" >> "$SSH_LOG"
    start=$EPOCHREALTIME
    code=0
    print -r -- "$question" | "$target" --chat || code=$?
    print -r -- "$(/bin/date '+%F %T')  $script --chat: end, exit $code, $(printf '%.1f' $(( EPOCHREALTIME - start ))) s" >> "$SSH_LOG"
    exit $code
    ;;
  (*)
    refuse
    ;;
esac
